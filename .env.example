# 配置样例。复制为 .env 后按需修改；所有变量都以 WRC_ 为前缀。
# CLI 参数会覆盖这里的环境变量。

# ---------- 路径 ----------
# 数据目录（原始数据、清洗层、日志、导出都在这里）
# WRC_DATA_DIR=./data

# ---------- 浏览器与登录 ----------
# 登录与人工验证必须可见，因此默认有头运行。仅在排障时才设为 true。
# WRC_HEADLESS=false
# 使用系统已安装的 Chrome/Edge 而不是内置 Chromium（当内置浏览器出问题时）
# WRC_BROWSER_CHANNEL=chrome
# 传输模式：context（默认，走 APIRequestContext）| page（页面内 fetch）
# WRC_FETCH_MODE=context
# 登录入口。桌面 UA 下 weibo.com/login.php 提供二维码
# WRC_LOGIN_URL=https://weibo.com/login.php
# 等待用户完成扫码登录的最长秒数
# WRC_LOGIN_TIMEOUT_S=300

# ---------- 采集频率纪律（不要为了速度把它们调没） ----------
# WRC_DELAY_MIN_S=1.5
# WRC_DELAY_MAX_S=3.0
# 单次采集的请求硬上限（统计全部出站请求，含重试）
# WRC_MAX_REQUESTS_PER_RUN=120
# 命中限流后的退避基数与上限（秒），按 2 的幂次增长
# WRC_BACKOFF_BASE_S=60
# WRC_BACKOFF_MAX_S=600
# WRC_MAX_RETRIES=2

# ---------- 采集默认值 ----------
# WRC_DEFAULT_POST_PREVIEW_COUNT=20
# WRC_DEFAULT_COMMENTS_PER_POST=50
# 二级评论默认关闭：数据量会呈数量级增长
# WRC_COLLECT_SUBCOMMENTS=false

# ---------- P1 预留（第 1 步未启用） ----------
# LLM 后端统一走 LLMClient 抽象，不在业务代码里硬编码任何厂商 SDK
# WRC_LLM_PROVIDER=deepseek
# WRC_LLM_API_KEY=
# WRC_LLM_MODEL=deepseek-chat
